+            for (int64_t row = 0; row < m; ++row) {
+                for (int64_t col = 0; col < k; ++col) {
+                    weights[(expert*m + row)*k + col] = (col/256)%3 == row%3
+                        ? 0.25f*(expert + 1)*(1 + row/3 + (col%256)/2%3) : 0.0f;
+                }
+            }
+        }
