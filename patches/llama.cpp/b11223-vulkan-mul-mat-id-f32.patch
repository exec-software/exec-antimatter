+        ggml_set_name(as, "as");
+        ggml_tensor * b = ggml_new_tensor_3d(ctx, GGML_TYPE_F32, k + (padded ? 16 : 0), (broadcast ? 1 : n_used) + (padded ? 1 : 0), n);
