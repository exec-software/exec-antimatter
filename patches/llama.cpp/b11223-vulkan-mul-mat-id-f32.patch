+        ggml_quantize_chunk(type_a, weights.data(), quantized.data(), 0, m*n_mats, k, nullptr);
+        ggml_backend_tensor_set(as, quantized.data(), 0, quantized.size());
+        ggml_get_type_traits(type_a)->to_float(quantized.data(), weights.data(), weights.size());
+
+        std::vector<float> activations(ggml_nelements(bs), -17.0f);
+        std::vector<int32_t> routes(ggml_nelements(ids_storage), n_mats - 1);
+        for (int64_t token = 0; token < n; ++token) {
+            for (int slot = 0; slot < n_used; ++slot) {
+                // Slots 1 and 3 use the same expert but different activation rows.
+                const int route = (n_mats - 1 + 3*token + (slot == 3 ? 1 : slot))%n_mats;
+                routes[token*ids_storage->ne[0] + slot] = route;
+            }
+            for (int64_t slot = 0; slot < b->ne[1]; ++slot) {
+                for (int64_t col = 0; col < k; ++col) {
+                    float value;
+                    switch ((col/256)%3) {
+                        case 0: value = 131072.0f + 256.0f*token + 32.0f*slot + col%13; break;
+                        case 1: value = std::ldexp(1.0f + 0.25f*(token%7) + 0.5f*slot + 0.125f*(col%5), -30); break;
+                        default: {
+                            const float high = 1024.0f + 4.0f*(token%4) + 2.0f*slot;
+                            value = col%2 == 0 ? high : -high + 0.25f*(1 + (token + slot)%3);
+                            break;
+                        }
+                    }
+                    activations[(b->view_offs + token*b->nb[2] + slot*b->nb[1])/sizeof(float) + col] = value;
+                }
+            }
+        }
+        ggml_backend_tensor_set(bs, activations.data(), 0, ggml_nbytes(bs));
+        ggml_backend_tensor_set(ids_storage, routes.data(), 0, ggml_nbytes(ids_storage));
+
+        // The CPU backend quantizes source1 too. Use dequantized weights and the original F32 rows as the oracle.
+        expected.resize(m*n_used*n);
+        for (int64_t token = 0; token < n; ++token) {
+            for (int slot = 0; slot < n_used; ++slot) {
+                const int expert = routes[token*ids_storage->ne[0] + slot];
+                const float * input = activations.data() + (b->view_offs + token*b->nb[2] + (slot%b->ne[1])*b->nb[1])/sizeof(float);
+                for (int64_t row = 0; row < m; ++row) {
+                    const float * weight = weights.data() + (expert*m + row)*k;
+                    double sum = 0.0;
+                    for (int64_t col = 0; col < k; ++col) {
+                        sum += double(weight[col])*input[col];
+                    }
+                    expected[(token*n_used + slot)*m + row] = sum;
+                    GGML_ASSERT(std::isfinite(sum) && sum != 0.0);
+                }
+            }
+        }
+    }
+};
