+        for (size_t i = 0; i < count; ++i) {
+            if (!std::isfinite(a[i]) || !std::isfinite(expected[i])) {
+                return INFINITY;
+            }
+            worst = std::max(worst, std::abs(double(a[i]) - expected[i]) / std::max(std::abs(double(expected[i])), 1e-20));
+        }
+        return worst;
+    }
