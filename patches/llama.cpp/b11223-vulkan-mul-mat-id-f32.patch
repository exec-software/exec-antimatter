+            }
+        }
+        ggml_tensor * as = ggml_get_tensor(ctx, "as");
+        ggml_tensor * b = ggml_get_tensor(ctx, "b");
+        ggml_tensor * bs = b->view_src ? b->view_src : b;
+        ggml_tensor * ids = ggml_get_tensor(ctx, "ids");
+        ggml_tensor * ids_storage = ids->view_src;
